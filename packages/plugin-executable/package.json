  "devDependencies": {
    "@thy-weaver/core": "workspace:*",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@thy-weaver/core": "workspace:^"
  },
  "dependencies": {
    "@electron/asar": "4.3.1",
    "fflate": "0.8.2",
    "ora": "catalog:",
    "picocolors": "catalog:"
  }
