{
  "name": "@thy-weaver/plugin-executable",
  "private": true,
  "version": "0.0.0",
  "description": "Packages ThyWeaver games as lightweight desktop apps (Neutralinojs), with saves synced to disk",
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "license": "MIT",
  "homepage": "https://github.com/greatsquare0/thy-weaver/tree/main/packages/plugin-executable",
  "repository": {
