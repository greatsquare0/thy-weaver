{
  "name": "@thy-weaver/plugin-executable",
  "version": "0.1.0-beta.0",
  "description": "Packages ThyWeaver games as lightweight desktop apps (Neutralinojs), with saves synced to disk",
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "license": "MIT",
  "homepage": "https://github.com/greatsquare0/thy-weaver/tree/main/packages/plugin-executable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greatsquare0/thy-weaver.git",
    "directory": "packages/plugin-executable"
  },
  "bugs": "https://github.com/greatsquare0/thy-weaver/issues",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --dts",
    "dev": "tsdown --watch"
  },
  "keywords": [
    "Twine",
    "Twee",
    "Twee3",
    "Tweego",
    "ThyWeaver",
    "Weaver"
