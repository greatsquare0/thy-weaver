{
  "name": "@thy-weaver/monorepo",
  "private": "true",
  "type": "module",
  "description": "A starter template for a modern Twine development workflow",
  "homepage": "https://github.com/greatsquare0/thy-weaver/",
  "repository": {
    "type": "git",
    "url": "https://github.com/greatsquare0/thy-weaver/"
  },
  "bugs": "https://github.com/greatsquare0/thy-weaver/issues",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "turbo build && vitest run --project e2e",
    "test:all": "turbo build && vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "test:types": "tsc -p tsconfig.test.json",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "template-author": "greatsquare0",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@prettier/plugin-oxc": "^0.2.3",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.1.0",
    "fflate": "0.8.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.19.0"
}
